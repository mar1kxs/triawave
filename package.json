{
  "name": "triawave-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check && npm run build:client && npm run build:ssr && npm run prerender && npm run seo:check",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "preview": "vite preview",
    "check": "tsc -b --pretty false",
    "prerender": "node scripts/prerender.mjs",
    "seo:check": "node scripts/seo-check.mjs",
    "validate": "npm run build"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.9",
    "lenis": "^1.3.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
